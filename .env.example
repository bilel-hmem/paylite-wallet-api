# Copy to .env and adjust. All amounts are in millimes (1 TND = 1000 millimes).
NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=paylite
DB_PASSWORD=paylite
DB_NAME=paylite

# Use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN_SECONDS=3600
BCRYPT_ROUNDS=10

# 2,000 TND per wallet per day
DAILY_TRANSFER_LIMIT=2000000
# Requests per minute per IP
THROTTLE_LIMIT=100
