# Test-only values used by `npm run test:e2e`. Safe to commit: no real secrets.
# The database name MUST end with "_test": the e2e suite truncates its tables.
NODE_ENV=test
DB_HOST=localhost
DB_PORT=3306
DB_USER=paylite
DB_PASSWORD=paylite
DB_NAME=paylite_test
JWT_SECRET=test-secret-not-for-production
BCRYPT_ROUNDS=4
